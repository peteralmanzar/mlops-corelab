{
  "_comment": "Base configuration template for MLOps CoreLab. Experiment-specific configs override these defaults.",
  "MLFLOW": {
    "TRACKING_URI": "http://mlflow:5000",
    "EXPERIMENT_NAME": "Default"
  },
  "RANDOM_SEED": 42,
  "DEFAULT_DAG_ARGS": {
    "owner": "mlops",
    "depends_on_past": false,
    "email_on_failure": false,
    "email_on_retry": false,
    "retries": 1,
    "retry_delay_seconds": 300
  },
  "DATA": {
    "RAW_PATH_FILE": "/opt/airflow/data/train.csv",
    "PROCESSED_PATH": "/opt/airflow/data/processed",
    "TRAIN_TEST_SPLIT": 0.2,
    "FOLD_TYPE": null,
    "NUM_FOLDS": 5,
    "KFOLD_SHUFFLE": true,
    "KFOLD_RANDOM_STATE": 42,
    "STRATIFY_COLUMN": null,
    "TIME_COLUMN": null,
    "TIME_SERIES_GAP": 0,
    "TIME_SERIES_EXPANDING": true
  },
  "PREPROCESSING": {
    "FEATURES_PATH": "/opt/airflow/data/features",
    "PIPELINE_SPEC": {
      "steps": [
        {"dateSplit": {"columns": [], "dropColumns": true}},
        {"imputer": {"columns": [], "numeric_strategy": "mean", "categorical_strategy": "mode"}},
        {"dropNullRows": {"columns": []}},
        {"scaler": {"columns": []}},
        {"onehot": {"columns": []}},
        {"drop": {"columns": []}},
        {"index": {"column": ""}},
        {"sequencer": {"column": "", "sequence_length": 60, "sortlook": "", "datetime_column": ""}}
      ]
    }
  },
  "MODEL": {
    "ARTIFACTS_PATH": "/mlflow/artifacts",
    "LABEL_COLUMNS": ["target"],
    "EPOCHS": 200,
    "BATCH_SIZE": 50,
    "OPTIMIZER": "adam",
    "EARLY_STOPPING_PATIENCE": 10,
    "VALIDATION_SPLIT": 0.2
  },
  "PROMOTION": {
    "MODEL_NAME": "ml_pipeline_model",
    "CHAMPION_ALIAS": "champion",
    "CHALLENGER_ALIAS": "challenger",
    "COMPARISON_METRIC": "test_accuracy",
    "HIGHER_IS_BETTER": true,
    "MIN_IMPROVEMENT_THRESHOLD": 0.0,
    "AUTO_PROMOTE_FIRST_MODEL": true,
    "FASTAPI_URL": "http://model-serve:8000"
  },
  "HYPERPARAMETER_TUNING": {
    "ENABLED": false,
    "N_TRIALS": 50,
    "TIMEOUT_SECONDS": 3600,
    "SAMPLER": "TPE",
    "PRUNER": {
      "TYPE": "MedianPruner",
      "N_STARTUP_TRIALS": 5,
      "N_WARMUP_STEPS": 10,
      "INTERVAL_STEPS": 1
    },
    "VALIDATION_SPLIT_FOR_TUNING": 0.2,
    "TUNING_EPOCHS": 30,
    "SEARCH_SPACE": {
      "ARCHITECTURE": {
        "NUM_HIDDEN_LAYERS": {"low": 1, "high": 4},
        "HIDDEN_UNITS": {"low": 32, "high": 256, "step": 32},
        "DROPOUT_RATE": {"low": 0.0, "high": 0.5, "step": 0.1},
        "ACTIVATION": ["relu", "tanh", "selu", "elu"]
      },
      "TRAINING": {
        "LEARNING_RATE": {"low": 1e-5, "high": 1e-2, "log": true},
        "BATCH_SIZE": [16, 32, 64, 128, 256],
        "OPTIMIZER": ["adam", "rmsprop", "sgd", "adamax", "nadam"]
      }
    },
    "MLFLOW_TRACKING": {
      "LOG_TRIALS": true,
      "LOG_IMPORTANCE": true,
      "LOG_VISUALIZATION": true
    }
  }
}
