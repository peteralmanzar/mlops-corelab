{
  "config_version": 1,
  "DATA_RAW_PATH_FILE": "/opt/airflow/data/train.csv",
  "DATA_PROCESSED_PATH": "/opt/airflow/data/processed",
  "DATA_FEATURES_PATH": "/opt/airflow/data/features",
  "MODEL_ARTIFACTS_PATH": "/mlflow/artifacts",
  "PREPROCESSING_PIPELINE_SPEC": {
    "steps": [
      {"dateSplit": {"columns": [], "dropColumns": true}},
      {"imputer": {"columns": ["Age"], "numeric_strategy": "mean", "categorical_strategy": "constant", "fill_value": 0}},
      {"imputer": {"columns": [], "numeric_strategy": "constant", "categorical_strategy": "mode", "fill_value": "Unknown"}},
      {"scaler": {"columns": ["Age", "Pclass", "SibSp", "Fare"]}},
      {"onehot": {"columns": ["Sex"]}},
      {"drop": {"columns": ["PassengerId", "Name", "Ticket", "Parch", "Cabin", "Embarked"]}},
      {"index": {"column": ""}},
      {"sequencer": {"column": "", "sequence_length": 60}}
    ]
  },
  "MLFLOW_TRACKING_URI": "http://mlflow:5000",
  "MLFLOW_EXPERIMENT_NAME": "ml_pipeline",
  "DATA_VALIDATION_RULES": {"max_null_percentage": 0.1, "min_rows": 100, "required_columns": []},
  "TRAIN_TEST_SPLIT": 0.2,
  "RANDOM_SEED": 42,
  "MODEL_PARAMS": {"n_estimators": 100, "max_depth": 10, "random_state": 42},
  "MODEL_SPEC": {
    "type": "sklearn",
    "name": "ml_pipeline_model",
    "framework": "sklearn",
    "params": {"n_estimators": 100, "max_depth": 10, "random_state": 42},
    "save_format": "pickle",
    "artifact_path": "/mlflow/artifacts/models",
    "template": null,
    "template_args": null
  },
  "LABEL_COLUMNS": ["Survived"],
  "MODEL_VALIDATION_THRESHOLDS": {"min_accuracy": 0.75, "min_precision": 0.7, "min_recall": 0.7, "min_f1": 0.7, "max_inference_time_ms": 1000},
  "FOLD_TYPE": null,
  "NUM_FOLDS": 5,
  "KFOLD_SHUFFLE": true,
  "KFOLD_RANDOM_STATE": 42,
  "TIME_COLUMN": null,
  "TIME_SERIES_GAP": 0,
  "TIME_SERIES_EXPANDING": true,
  "DAG_DATA_SCHEDULE": null,
  "DAG_PIPELINE_SCHEDULE": null,
  "DAG_TRAIN_SCHEDULE": null,
  "ALERT_EMAIL": ["admin@example.com"],
  "SLACK_WEBHOOK": null,
