@page "/documentation"

<PageTitle>Documentation - MLOps Dashboard</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-5">Documentation</h1>
            <p class="lead text-muted">Official documentation for MLOps services</p>
        </div>
    </div>

    <div class="row">
        @foreach (var doc in _documentationLinks)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@doc.Name</h5>
                        <p class="card-text text-muted">@doc.Description</p>
                    </div>
                    <div class="card-footer bg-transparent">
                        <a href="@doc.Url" target="_blank" class="btn btn-outline-primary">
                            View Documentation
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private readonly List<DocumentationLink> _documentationLinks = new()
    {
        new("Kestra", "Learn about declarative data orchestration and workflow automation with Kestra.", "https://kestra.io/docs/tutorial"),
        new("JupyterLab", "Interactive development environment for notebooks, code, and data.", "https://jupyterlab.readthedocs.io/en/3.1.x/index.html"),
        new("Airflow", "Platform to programmatically author, schedule, and monitor workflows.", "https://airflow.apache.org/docs/apache-airflow/stable/index.html"),
        new("MLflow", "Open source platform for the machine learning lifecycle.", "https://mlflow.org/docs/latest/ml/"),
    };

    private record DocumentationLink(string Name, string Description, string Url);
}
