@page "/templates"
@using MLOpsDashboard.Core.Models
@using MLOpsDashboard.Web.Services
@inject TemplateService TemplateService

<PageTitle>Templates</PageTitle>

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Experiment Templates</h2>
    </div>

    @if (_templates == null)
    {
        <p>Loading...</p>
    }
    else if (_templates.Count == 0)
    {
        <div class="alert alert-info">
            No templates found. Templates will appear when you save experiment configurations.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var template in _templates)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">@template.Name</h5>
                            <p class="card-text text-muted small">@(template.Description ?? "No description")</p>
                            <span class="badge bg-secondary">@template.TemplateType</span>
                        </div>
                        <div class="card-footer bg-transparent">
                            <small class="text-muted">
                                Created: @template.CreatedAt.ToString("d")
                            </small>
                            <div class="mt-2">
                                <a href="/experiments/create?template=@template.Id" class="btn btn-sm btn-primary">
                                    Use Template
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<ExperimentTemplate>? _templates;

    protected override async Task OnInitializedAsync()
    {
        _templates = await TemplateService.GetAllTemplatesAsync();
    }
}
